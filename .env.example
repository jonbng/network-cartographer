# Copy to .env (gitignored) if you use scripts/update-geolite2.sh
# Get a free key: https://www.maxmind.com/en/geolite2/signup
MAXMIND_LICENSE_KEY=

# Optional local MMDB overrides (absolute paths)
# NETWORK_CARTOGRAPHER_MMDB=/path/to/GeoLite2-City.mmdb
# NETWORK_CARTOGRAPHER_ASN_MMDB=/path/to/GeoLite2-ASN.mmdb

# Optional hosted geo endpoint override (default: https://mapmy.network/api/v1/geo)
# NETWORK_CARTOGRAPHER_GEO_URL=http://127.0.0.1:3000/api/v1/geo
