{
  "name": "network-cartographer",
  "private": true,
  "version": "0.1.1",
  "description": "Map My Network — a local CLI network monitor with a browser-based 3D globe UI",
  "author": "Jonathan Bangert",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonbng/network-cartographer.git"
  },
  "bugs": {
    "url": "https://github.com/jonbng/network-cartographer/issues"
  },
  "homepage": "https://github.com/jonbng/network-cartographer#readme",
  "keywords": [
    "cli",
    "network",
    "traceroute",
    "geoip",
    "browser",
    "globe",
    "monitoring",
    "network-cartographer"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run build && cargo run --manifest-path server/Cargo.toml --",
    "start": "npm run dev",
    "frontend:dev": "vite",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && cargo check --locked --manifest-path server/Cargo.toml && cargo check --locked --manifest-path geo-service/Cargo.toml",
    "test": "cargo test --locked --manifest-path server/Cargo.toml"
  },
  "dependencies": {
    "globe.gl": "^2.46.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
